<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- Every hostile-to-scrapers behaviour is switched on deliberately. -->
    <pages enableEventValidation="true"
           viewStateEncryptionMode="Auto"
           enableViewStateMac="true" />

    <!-- Fixed key so ViewState MAC behaviour is reproducible across machines.-->
    <machineKey
      validationKey="8F2A1C4E6B9D0F3A5C7E1B4D8A2F6C9E0B3D5A7F1C4E8B2D6A9F0C3E5B7D1A4F8C2E6B9D0A3F5C7E1B4D8A2F6C9E0B3D5A7F1C4E8B2D6A9F0C3E5B7D1A4F"
      decryptionKey="A3F7C1E9B5D2A8F4C0E6B2D9A5F1C7E3B9D5A1F7C3E0B6D2A8F4C1E7B3D9A5F1"
      validation="HMACSHA256"
      decryption="AES" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="30" name=".DEMOAUTH" slidingExpiration="true" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" timeout="30" />
  </system.web>

  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>